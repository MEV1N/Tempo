# Tempo Environment Configuration

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempo?schema=public"

# Frontend / CORS
CORS_ORIGIN="http://localhost:3000"
VITE_API_URL="http://localhost:5000"

# Security (Foundation)
JWT_SECRET="tempo-dev-secret-key-change-in-production"

# Redis & Background Workers (Phase 6)
REDIS_URL="redis://localhost:6379"

# Web Push Notifications (Phase 6 VAPID keys)
VAPID_PUBLIC_KEY="BFuWlJhM3yCsY8c26RwMoqviRmWi8dtwZKMTM585qIGOQt7CPhYlyaFg7_lb7WERJal-PnEIh0qpKtRzW0c52RE"
VAPID_PRIVATE_KEY="your-vapid-private-key-placeholder"
